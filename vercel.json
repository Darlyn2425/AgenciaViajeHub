{
    "framework": null,
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
            ]
        },
        {
            "source": "/App/index.html",
            "headers": [
                { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
            ]
        },
        {
            "source": "/App/js/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
            ]
        },
        {
            "source": "/App/styles.css",
            "headers": [
                { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/auth/login",
            "destination": "/api/auth?route=login"
        },
        {
            "source": "/api/auth/session",
            "destination": "/api/auth?route=session"
        },
        {
            "source": "/api/auth/profile",
            "destination": "/api/auth?route=profile"
        },
        {
            "source": "/api/auth/reset",
            "destination": "/api/auth?route=reset"
        },
        {
            "source": "/api/auth/users",
            "destination": "/api/auth?route=users"
        },
        {
            "source": "/api/auth/token",
            "destination": "/api/auth?route=token"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/",
            "destination": "/App/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/App/$1"
        }
    ]
}
